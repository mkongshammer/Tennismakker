{
  "expo": {
    "name": "RacketBuddy",
    "slug": "racketbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "racketbuddy",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3D2F"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow RacketBuddy to use Face ID to unlock the app."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.racketbuddy.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dk.racketbuddy.app",
      "versionCode": 100,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3D2F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://eu.racketbuddy.app",
      "apiUrlUs": "https://racketbuddy.app",
      "googleWebClientId": "367445361935-os7taa4egjiaf7e2ct67copfrocp5tos.apps.googleusercontent.com",
      "eas": {
        "projectId": "6f8383f0-de60-4b32-9104-1cec88ba543c"
      }
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "owner": "magnuskongs99"
  }
}
