{
  "name": "tennis-makker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --skip-generate || echo 'Skema ikke opdateret - koer prisma db push manuelt') && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:push && npm run db:seed",
    "images:migrate": "tsx prisma/migrate-images.ts",
    "test:database": "node --import tsx scripts/test-club-database.ts",
    "test:app": "node --import tsx scripts/test-club-database.ts --http",
    "test:control": "node --import tsx scripts/test-club-control.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//": "Byggev\u00e6rkt\u00f8jerne ligger bevidst i dependencies, ikke devDependencies: Render s\u00e6tter NODE_ENV=production og springer devDependencies over ved install, og s\u00e5 fejler bygningen p\u00e5 manglende tailwind/typescript.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "next": "^15.5.25",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
