// RacketBuddy — datamodel
// PostgreSQL (Render). Enums er gemt som String, oprindeligt af hensyn til
// SQLite-kompatibilitet i lokal udvikling — kan konverteres til rigtige
// Prisma-enums når al lokal udvikling også er på Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Brugere ----------
// role: "PLAYER" | "COACH" | "CLUB_ADMIN"
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("PLAYER")
  level        Int      @default(3) // 1-7, se src/lib/levels.ts
  area         String? // fx "København NV", "Aarhus C"
  country      String   @default("DK") // ISO-landekode, styrer hvad man ser
  // Har man selv valgt land, eller er "DK" bare standarden? Uden dette kan
  // vi ikke se forskel på en dansker og en tysker, der endnu ikke er
  // blevet spurgt — og så ville vi enten spørge alle hver gang eller
  // aldrig spørge nogen.
  countryChosen Boolean @default(false)
  // Hvornår handelsbetingelserne blev accepteret. Uden et tidsstempel kan
  // vi ikke vise, at nogen sagde ja — og "de stod på siden" er ikke et
  // bevis, hvis det en dag bliver en tvist.
  termsAcceptedAt DateTime?
  /// Stripe-kunde, hvis personen har gemt et kort til fornyelse.
  stripeCustomerId String?
  locale       String   @default("da") // se LOCALES i src/lib/sports.ts
  sports       String   @default("TENNIS") // kommasepareret, fx "TENNIS,PADEL"
  // Skelner mellem det gamle standardvalg TENNIS og et aktivt valg. Alle
  // eksisterende brugere får false ved migreringen og bliver derfor spurgt
  // én gang næste gang de bruger websitet. Nye brugere sættes til true,
  // når deres valg fra oprettelsen er gemt.
  sportsChosen Boolean @default(false)
  bio          String?
  createdAt    DateTime @default(now())

  clubId String? // klub-admins og medlemmer kan være tilknyttet en klub
  club   Club?   @relation(fields: [clubId], references: [id])

  coachProfile    CoachProfile?
  bookings        Booking[]
  matchRequests   MatchRequest[] @relation("requester")
  matchResponses  MatchRequest[] @relation("acceptedBy")
  messages        Message[]
  swipesGiven     Swipe[]        @relation("swipesGiven")
  swipesReceived  Swipe[]        @relation("swipesReceived")
  reviews         Review[]
  loginChallenges LoginChallenge[]
  passwordResets  PasswordReset[]
  fixedSlots      FixedSlot[]
  memberships     Membership[]
  teamSignups     TeamSignup[]
  punchPurchases  ClubPunchPurchase[]
  packagePurchases PackagePurchase[]
}

// ---------- Modul C: Klubber ----------
// integrationType afgør, hvor ledige tider kommer fra:
//   NATIVE  — RacketBuddy ER klubbens bookingsystem (fallback for klubber uden system)
//   MANUAL  — klubben frigiver selv enkelte gæstetider (virker uden aftale med nogen)
//   ICAL    — vi spejler optaget-tider fra en kalenderfeed fra klubbens eget system
//   API     — direkte integration mod fx Halbooking (kræver partneraftale, ikke bygget endnu)
model Club {
  id          String   @id @default(cuid())
  slug        String   @unique // fx "demo-tennisklub" -> /klub/demo-tennisklub
  name        String
  city        String
  description String?
  color       String   @default("#1E3D2F") // klubbens egen farve på klubsiden
  priceHour   Int      @default(80) // banepris i kr pr. time
  openHour    Int      @default(7)
  closeHour   Int      @default(22)
  createdAt   DateTime @default(now())

  // Klubben vælger: COMMISSION (vi tager 10% af hver gæstebooking) eller
  // SUBSCRIPTION (fast beløb pr. måned, klubben beholder hele bookingen).
  billingModel   String @default("COMMISSION")
  subscriptionKr Int    @default(199)

  // Abonnementet, klubben betaler TIL os. Ikke det samme som
  // stripeAccountId nedenfor, som er den konto, vi betaler penge UD til:
  // her er klubben kunde hos os, dér er de modtager. To forskellige roller,
  // to forskellige id'er, og de må ikke forveksles.
  stripeCustomerId     String?
  subscriptionId       String?
  // "active" | "trialing" | "past_due" | "canceled" | "unpaid" — Stripes egne
  // navne, så et event kan skrives direkte ind uden oversættelse.
  subscriptionStatus   String?
  subscriptionRenewsAt DateTime?

  country String @default("DK")

  // Stripe Connect — kontoen pengene sendes videre til, når nogen booker
  // en bane. chargesEnabled/payoutsEnabled opdateres af Stripes webhook
  // og afgør, om klubben overhovedet kan modtage betalinger endnu.
  stripeAccountId      String?
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // Adgang til anlægget. Vises kun til folk der rent faktisk har booket —
  // i kvitteringsmailen og på deres profil, aldrig på den offentlige
  // klubside. En kode alle kan se, er ingen kode.
  hasLock            Boolean @default(false)
  accessCode         String?
  accessInstructions String?

  // Klubber godkendes manuelt, før de bliver synlige. En klub der påstår
  // at have baner, den ikke har, ødelægger tilliden for alle andre.
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  approvedAt   DateTime?
  reviewNote   String? // intern note, vises ikke for klubben
  contactPhone String?

  // Klubbens hjemmeside hos os. Klubber på NATIVE bruger os som deres
  // primære system; andre kan stadig købe hjemmesiden og have en ekstern
  // bookingknap.
  tagline        String?
  about          String?
  practicalInfo  String?
  membershipInfo String?
  contactEmail   String?
  websiteUrl     String?
  joinCode       String?

  // Betalt hjemmesideprodukt.
  websiteTheme  String  @default("KLASSISK") // KLASSISK | MARKANT | ENKEL
  websiteLogoId String?
  websiteHeroId String?
  customDomain  String?
  domainStatus  String  @default("NONE") // NONE | PENDING | ACTIVE | ERROR

  // Booking- og medlemsregler.
  membersOnlyBooking Boolean @default(false)
  allowGuestBooking  Boolean @default(true)
  maxAdvanceDays     Int     @default(14)
  cancellationHours  Int     @default(24)

  // Integration mod eksisterende system.
  integrationType String @default("NATIVE") // NATIVE | MANUAL | ICAL | API
  icalUrl         String?
  externalSystem  String?
  syncStatus      String?
  lastSyncAt      DateTime?

  courts          Court[]
  admins          User[]
  memberships     Membership[]
  posts           ClubPost[]
  people          ClubPerson[]
  systemLogin     ClubSystemLogin?
  membershipTypes MembershipType[]
  seasonTeams     SeasonTeam[]
  punchCards      ClubPunchCard[]
  priceRules      PriceRule[]
  images          Image[]
  bookings        Booking[]
  fixedSlots      FixedSlot[]
}

model Court {
  id        String @id @default(cuid())
  clubId    String
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  sport     String @default("TENNIS")
  surface   String?
  indoor    Boolean @default(false)
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  bookings   Booking[]
  fixedSlots FixedSlot[]
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("PENDING")
  priceKr   Int
  createdAt DateTime @default(now())

  stripePaymentIntentId String?
  paymentStatus         String?
  refundedAt            DateTime?
  cancelledAt           DateTime?
  accessSentAt          DateTime?
  renewalOfId           String?

  packagePurchaseId String?
  packagePurchase   PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])
  punchPurchaseId   String?
  punchPurchase     ClubPunchPurchase? @relation(fields: [punchPurchaseId], references: [id])
  review            Review?
}

model MatchRequest {
  id           String   @id @default(cuid())
  requesterId  String
  requester    User     @relation("requester", fields: [requesterId], references: [id])
  acceptedById String?
  acceptedBy   User?    @relation("acceptedBy", fields: [acceptedById], references: [id])
  message      String
  area         String
  level        Int
  sport        String
  matchType    String
  source       String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  matchRequestId String
  matchRequest   MatchRequest @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

model Swipe {
  id         String   @id @default(cuid())
  swiperId   String
  swiper     User     @relation("swipesGiven", fields: [swiperId], references: [id])
  swipedId   String
  swiped     User     @relation("swipesReceived", fields: [swipedId], references: [id])
  direction  String
  createdAt  DateTime @default(now())

  @@unique([swiperId, swipedId])
}

model CoachProfile {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String
  sports       String
  priceHour    Int
  specialties  String
  area         String
  stripeAccountId String?
  stripeOnboarded Boolean @default(false)
  createdAt    DateTime @default(now())

  images       Image[]
  weeklySlots  WeeklyCoachSlot[]
  lessons      CoachLesson[]
  packages     CoachPackage[]
}

model WeeklyCoachSlot {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinutes   Int
  endMinutes     Int
  active         Boolean      @default(true)

  @@index([coachProfileId, weekday])
}

model CoachLesson {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id])
  studentId      String
  student        User         @relation(fields: [studentId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  priceKr        Int
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())

  stripePaymentIntentId String?
  paymentStatus         String?
  refundedAt            DateTime?
  cancelledAt           DateTime?
  packagePurchaseId     String?
  packagePurchase       PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])
  review                Review?
}

model CoachPackage {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  name           String
  lessons        Int
  minutes        Int
  priceKr        Int
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  purchases PackagePurchase[]
}

model PackagePurchase {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  packageId      String
  package        CoachPackage @relation(fields: [packageId], references: [id])
  lessonsTotal   Int
  lessonsUsed    Int          @default(0)
  paidKr         Int
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())

  stripePaymentIntentId String?
  paymentStatus         String?

  lessons CoachLesson[]
  bookings Booking[]
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  rating      Int
  body        String?
  bookingId   String?  @unique
  booking     Booking? @relation(fields: [bookingId], references: [id])
  lessonId    String?  @unique
  lesson      CoachLesson? @relation(fields: [lessonId], references: [id])
  createdAt   DateTime @default(now())
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Image {
  id             String   @id @default(cuid())
  clubId         String?
  club           Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coachProfileId String?
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  kind           String
  mime           String
  bytes          Bytes?
  storageKey     String?
  publicUrl      String?
  width          Int?
  height         Int?
  approved       Boolean  @default(false)
  alt            String?
  createdAt      DateTime @default(now())
}

model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MembershipType {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  priceKr   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id               String         @id @default(cuid())
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipTypeId String?
  membershipType   MembershipType? @relation(fields: [membershipTypeId], references: [id])
  status           String         @default("ACTIVE")
  startsAt         DateTime       @default(now())
  endsAt           DateTime?
  createdAt        DateTime       @default(now())

  @@unique([clubId, userId])
}

model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ClubPerson {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  role      String
  email     String?
  phone     String?
  sortOrder Int      @default(0)
}

model ClubSystemLogin {
  id           String @id @default(cuid())
  clubId       String @unique
  club         Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  system       String
  loginUrl     String?
  usernameEnc  String
  passwordEnc  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MembershipTypeRule {
  id               String @id @default(cuid())
  membershipTypeId String
  membershipType   MembershipType @relation(fields: [membershipTypeId], references: [id], onDelete: Cascade)
  key              String
  value            String
}

model SeasonTeam {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  sport     String
  capacity  Int?
  startsAt  DateTime
  endsAt    DateTime
  priceKr   Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  signups TeamSignup[]
}

model TeamSignup {
  id        String     @id @default(cuid())
  teamId    String
  team      SeasonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())

  @@unique([teamId, userId])
}

model ClubPunchCard {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  credits   Int
  priceKr   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases ClubPunchPurchase[]
}

model ClubPunchPurchase {
  id        String        @id @default(cuid())
  punchCardId String
  punchCard ClubPunchCard @relation(fields: [punchCardId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  creditsTotal Int
  creditsUsed  Int        @default(0)
  paidKr       Int
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())

  stripePaymentIntentId String?
  paymentStatus         String?
  bookings              Booking[]
}

model PriceRule {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  weekday   Int?
  startHour Int?
  endHour   Int?
  priceKr   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FixedSlot {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int
  startMinutes Int
  endMinutes   Int
  startsOn  DateTime
  endsOn    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([clubId, weekday])
}
