// RacketBuddy — datamodel
// PostgreSQL (Render). Enums er gemt som String, oprindeligt af hensyn til
// SQLite-kompatibilitet i lokal udvikling — kan konverteres til rigtige
// Prisma-enums når al lokal udvikling også er på Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Brugere ----------
// role: "PLAYER" | "COACH" | "CLUB_ADMIN"
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("PLAYER")
  level        Int      @default(3) // 1-7, se src/lib/levels.ts
  area         String? // fx "København NV", "Aarhus C"
  country      String   @default("DK") // ISO-landekode, styrer hvad man ser
  locale       String   @default("da") // "da" | "en"
  sports       String   @default("TENNIS") // kommasepareret, fx "TENNIS,PADEL"
  bio          String?
  createdAt    DateTime @default(now())

  clubId String? // klub-admins og medlemmer kan være tilknyttet en klub
  club   Club?   @relation(fields: [clubId], references: [id])

  coachProfile    CoachProfile?
  bookings        Booking[]
  matchRequests   MatchRequest[] @relation("requester")
  matchResponses  MatchRequest[] @relation("acceptedBy")
  messages        Message[]
  swipesGiven     Swipe[]        @relation("swipesGiven")
  swipesReceived  Swipe[]        @relation("swipesReceived")
  reviews         Review[]
}

// ---------- Modul C: Klubber ----------
// integrationType afgør, hvor ledige tider kommer fra:
//   NATIVE  — RacketBuddy ER klubbens bookingsystem (fallback for klubber uden system)
//   MANUAL  — klubben frigiver selv enkelte gæstetider (virker uden aftale med nogen)
//   ICAL    — vi spejler optaget-tider fra en kalenderfeed fra klubbens eget system
//   API     — direkte integration mod fx Halbooking (kræver partneraftale, ikke bygget endnu)
model Club {
  id          String   @id @default(cuid())
  slug        String   @unique // fx "demo-tennisklub" -> /klub/demo-tennisklub
  name        String
  city        String
  description String?
  color       String   @default("#1E3D2F") // klubbens egen farve på klubsiden
  priceHour   Int      @default(80) // banepris i kr pr. time
  openHour    Int      @default(7)
  closeHour   Int      @default(22)
  createdAt   DateTime @default(now())

  // Klubben vælger: COMMISSION (vi tager 10% af hver gæstebooking) eller
  // SUBSCRIPTION (fast beløb pr. måned, klubben beholder hele bookingen).
  billingModel   String @default("COMMISSION")
  subscriptionKr Int    @default(199)

  country String @default("DK")

  // Stripe Connect — kontoen pengene sendes videre til, når nogen booker
  // en bane. chargesEnabled/payoutsEnabled opdateres af Stripes webhook
  // og afgør, om klubben overhovedet kan modtage betalinger endnu.
  stripeAccountId      String?
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // Adgang til anlægget. Vises kun til folk der rent faktisk har booket —
  // i kvitteringsmailen og på deres profil, aldrig på den offentlige
  // klubside. En kode alle kan se, er ingen kode.
  hasLock            Boolean @default(false)
  accessCode         String?
  accessInstructions String?

  // Klubber godkendes manuelt, før de bliver synlige. En klub der påstår
  // at have baner, den ikke har, ødelægger tilliden for alle andre.
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  approvedAt   DateTime?
  reviewNote   String? // intern note, vises ikke for klubben
  contactPhone String?

  // Klubbens hjemmeside hos os. Klubber på NATIVE bruger os som deres
  // eneste system og har ikke andet website — så siden her er klubbens
  // ansigt udadtil, ikke bare en bookingkalender.
  tagline        String? // én linje under navnet
  about          String? // om klubben
  practicalInfo  String? // adgang, parkering, omklædning, nøglebrik
  contactEmail   String?
  websiteUrl     String?
  joinCode       String? @unique // medlemmer melder sig ind med denne kode

  // Hjemmesiden som betalt ydelse.
  // theme: "KLASSISK" | "MARKANT" | "ENKEL"
  theme        String  @default("KLASSISK")
  logoId       String? // Image.id — vises i klubbens hoved
  heroId       String? // Image.id — stort billede øverst på klubbens side
  customDomain String? @unique // fx "soendermarktennis.dk"
  // "NONE" | "REQUESTED" | "PENDING_DNS" | "LIVE"
  domainStatus String  @default("NONE")
  memberPriceHour Int? // medlemspris; er den sat, betaler medlemmer den

  address   String? // gadeadresse, bruges til kortet og til at finde vej
  latitude  Float?
  longitude Float?

  integrationType String    @default("NATIVE")
  icalUrl         String? // feed-URL når integrationType = ICAL
  externalSystem  String? // fri tekst, fx "Halbooking (Globus Data)" — vises til klubben
  lastSyncAt      DateTime?
  lastSyncError   String?

  // Frigiv automatisk en ledig tid, når der er under så mange timer til
  // start. En bane der står tom om en time er tabt indtægt uanset hvad.
  lastMinuteHours Int @default(0)

  courts  Court[]
  members User[]
  reviews Review[]
  rules   GuestRule[]
  posts   ClubPost[]
  images  Image[]
}

// ---------- Billeder ----------
// Gemmes i databasen frem for hos en lagringsudbyder.
//
// Det er et bevidst valg for at komme i gang: ingen konto, ingen nøgler,
// ingen udgift, og billederne følger med i en databasesikkerhedskopi.
// Billeder skaleres og komprimeres før de gemmes, så en klub med logo,
// forsidebillede og et galleri fylder omkring en megabyte.
//
// Vokser det, flyttes lagringen til S3 eller lignende: alt, der læser og
// skriver billeder, går gennem src/lib/images.ts, så det er ét sted.
model Image {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  kind   String @default("PHOTO") // "LOGO" | "HERO" | "PHOTO"
  mime   String

  // Ét af to: enten ligger filen hos en lagringstjeneste (storageKey +
  // publicUrl), eller også ligger den i databasen (bytes). Databasen er
  // fallback, så platformen virker uden en lagringskonto.
  storageKey String?
  publicUrl  String?
  bytes      Bytes?

  width     Int
  height    Int
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([clubId, kind])
}

// ---------- Klubbens nyheder ----------
// Klubber uden eget website har brug for et sted at skrive "banerne er
// lukket på lørdag" og "klubmesterskab 12. maj".
model ClubPost {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

// surface: "GRUS" | "HARD" | "INDE"
model Court {
  id      String @id @default(cuid())
  name    String // fx "Bane 1"
  sport   String @default("TENNIS")
  surface String @default("GRUS")
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  bookings     Booking[]
  guestSlots   GuestSlot[]
  externalBusy ExternalBusy[]
}

// ---------- Frigivelsesregler ----------
// I stedet for at klubben skal frigive hver enkelt time, sætter de en regel
// op én gang: "bane 3 og 4, hverdage 9-15, 120 kr". Reglen genererer
// løbende ledige tider, indtil den slås fra.
//
// Det var den tungeste del af at være klub hos os: 20 timer om ugen
// skulle klikkes ind i hånden hver uge.
model GuestRule {
  id        String  @id @default(cuid())
  clubId    String
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtIds  String // kommasepareret, tom = alle klubbens baner
  daysOfWeek String // kommasepareret 0-6, 0 = søndag
  fromHour  Int
  toHour    Int
  priceKr   Int
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([clubId, active])
}

// ---------- Integration: manuelt frigivne gæstetider (integrationType = MANUAL) ----------
// Klubben bestemmer selv præcis hvilke tider udefrakommende spillere må se og booke.
// Tider der ikke ligger her, findes ikke for gæster.
model GuestSlot {
  id        String   @id @default(cuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  priceKr   Int
  createdAt DateTime @default(now())

  @@unique([courtId, startsAt])
  @@index([startsAt])
}

// ---------- Integration: spejlet optaget-tid fra klubbens eget system (integrationType = ICAL) ----------
// Cache af klubbens kalenderfeed. Vi ejer ikke disse bookinger — vi læser dem kun,
// for at kunne vise hvad der ER ledigt. Ryddes og genopbygges ved hver synkronisering.
model ExternalBusy {
  id       String   @id @default(cuid())
  courtId  String
  court    Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  label    String? // titel fra kalenderfeed, fx "Holdtræning U14"
  syncedAt DateTime @default(now())

  @@index([courtId, startsAt])
}

// ---------- Bookinger (baner + trænere) ----------
// kind: "COURT" | "COACH"
// status: "HOLD" | "CONFIRMED" | "CANCELLED"
model Booking {
  id            String    @id @default(cuid())
  kind          String
  status        String    @default("HOLD")
  startsAt      DateTime
  endsAt        DateTime
  priceKr       Int
  holdExpiresAt DateTime? // midlertidig reservation (10 min) mod dobbeltbooking
  createdAt     DateTime  @default(now())

  // True når klubben bruger sit eget bookingsystem (MANUAL/ICAL/API): bookingen
  // findes hos os, men skal også ind i klubbens system. Vises i klub-admin som
  // "skal indtastes", indtil klubben markerer den som ført ind.
  needsClubEntry Boolean   @default(false)
  clubEnteredAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courtId String?
  court   Court?  @relation(fields: [courtId], references: [id])

  coachProfileId String?
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id])

  payment Payment?
  review  Review?

  @@index([courtId, startsAt])
  @@index([coachProfileId, startsAt])
}

// ---------- Modul B: Trænere ----------
model CoachProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String // fx "DTF-uddannet træner, speciale i serv"
  sports      String @default("TENNIS") // kommasepareret
  priceHour   Int // kr pr. time
  specialties String // kommasepareret, fx "Serv,Baghånd,Junior"
  area        String
  // Ledige tider som ugentligt mønster: JSON [{ "day": 1, "from": 16, "to": 20 }] (day: 0=søn ... 6=lør)
  weeklySlots String @default("[]")

  // Stripe Connect — samme princip som Club, se dér.
  stripeAccountId      String?
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  bookings Booking[]
  reviews  Review[]
  packages CoachPackage[]
}

// ---------- Modul A: Makker-matching ----------
// status: "OPEN" | "MATCHED" | "CLOSED"
model MatchRequest {
  id        String   @id @default(cuid())
  status    String   @default("OPEN")
  message   String // fx "Søger single-makker tirsdag aften"
  area      String
  level     Int
  sport     String   @default("TENNIS")
  matchType String   @default("SINGLE") // "SINGLE" | "DOUBLE" | "TRAENING"
  source    String   @default("POST") // "POST" = opslag, "SWIPE" = gensidigt like
  createdAt DateTime @default(now())

  requesterId  String
  requester    User    @relation("requester", fields: [requesterId], references: [id])
  acceptedById String?
  acceptedBy   User?   @relation("acceptedBy", fields: [acceptedById], references: [id])

  messages Message[]
}

// ---------- Beskeder mellem matchede spillere ----------
// En tråd hænger på et makker-opslag: kun opslagets ejer og den, der slog
// til, kan læse og skrive i den.
model Message {
  id             String       @id @default(cuid())
  matchRequestId String
  matchRequest   MatchRequest @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([matchRequestId, createdAt])
}

// ---------- Betalinger ----------
// Abstraktion over betalingsudbyder (mock i udvikling, Stripe Connect i produktion).
// status: "PENDING" | "PAID" | "REFUNDED" | "FAILED"
model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  amountKr    Int
  platformFee Int // RacketBuddys andel (kommission/transaktionsgebyr)
  provider    String   @default("mock") // "mock" | "stripe"
  providerRef String? // fx Stripe PaymentIntent-id
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}


// ---------- Swipe-matching ----------
// Spillere gennemgår kort med andre spillere i deres område og på deres
// niveau. To likes den samme vej åbner automatisk en samtale.
model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("swipesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("swipesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  liked      Boolean
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId, liked])
}

// ---------- Anmeldelser ----------
// Kan kun skrives efter en gennemført booking, så vurderinger er knyttet til
// et reelt møde og ikke bare en holdning.
model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  coachProfileId String?
  coachProfile   CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  clubId         String?
  club           Club?         @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([coachProfileId])
  @@index([clubId])
}


// ---------- Trænerpakker ----------
// Ud over en enkelt time kan træneren sælge forløb: fx 10 timer til
// rabat, eller et begynderkursus over seks uger.
model CoachPackage {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  name           String // fx "10-turskort"
  description    String?
  sessions       Int // antal timer i pakken
  priceKr        Int // samlet pris
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([coachProfileId])
}


// ---------- Bestilling af hjemmeside ----------
// Den betalte opsætningsydelse: klubben får en færdig side på deres eget
// domæne, bygget af os. Bestillingen kommer typisk før klubben findes i
// systemet, så den står for sig selv og kobles på bagefter.
model WebsiteOrder {
  id          String   @id @default(cuid())
  clubName    String
  contactName String
  email       String
  phone       String?
  domain      String? // ønsket domæne, hvis de har et
  notes       String?
  // "NEW" | "CONTACTED" | "BUILDING" | "LIVE" | "CANCELLED"
  status      String   @default("NEW")
  priceKr     Int      @default(5000)
  internalNote String?
  clubId      String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}
