# Database (SQLite til udvikling — skift til PostgreSQL i produktion, se README)
DATABASE_URL="file:./dev.db"

# Hemmelig nøgle til session-cookies (generér med: openssl rand -base64 32)
AUTH_SECRET="skift-mig-til-en-lang-tilfaeldig-streng"

# ---------------------------------------------------------------------------
# Alt herunder kan sættes fra /superadmin/opsaetning i stedet og gemmes så i
# databasen. Variablerne her bruges som reserve: de gælder, indtil feltet er
# udfyldt inde i appen. De to ovenfor kan derimod ikke flyttes — de er selve
# adgangen til databasen og nøglen, der låser de gemte hemmeligheder op.
# ---------------------------------------------------------------------------

# Betaling: "mock" (udvikling) eller "stripe" (kræver nøgler, se src/lib/payments.ts)
PAYMENT_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."       # fra Stripe Dashboard -> Developers -> API keys
# STRIPE_WEBHOOK_SECRET="whsec_..."     # fra Stripe Dashboard -> Developers -> Webhooks, efter du har tilføjet endpointet

# Vores andel af hver booking, som decimaltal (0.10 = 10%)
# COMMISSION_PCT="0.10"

# Adressen appen svarer på — bruges i alle links i mails og retur fra Stripe
# APP_URL="https://racketbuddy.app"

# E-mail (Resend). Afsenderdomænet skal være verificeret hos udbyderen.
# EMAIL_API_KEY="re_..."
# EMAIL_FROM="RacketBuddy <ikke-svar@racketbuddy.app>"

# Fillagring (valgfri). Uden disse gemmes billeder i databasen.
# Cloudflare R2 anbefales: ingen udgift for trafik ud, 10 GB gratis.
#   1. Opret en bucket i Cloudflare-panelet
#   2. Lav en API-token med læse- og skriveadgang
#   3. Slå offentlig adgang til på bucketen, eller sæt et eget domæne på
# S3_BUCKET="racketbuddy-billeder"
# S3_ENDPOINT="https://<konto-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://pub-xxxx.r2.dev"
# S3_REGION="auto"

# Hvor klubhenvendelser og hjemmesidebestillinger sendes hen
# ORDERS_EMAIL=""
